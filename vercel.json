{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "fraudshield-pay-api": {
      "root": ".",
      "framework": "fastapi",
      "buildCommand": "pip install -r backend/requirements-deploy.txt"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "fraudshield-pay-api"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "fraudshield-pay-api"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "fraudshield-pay-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
